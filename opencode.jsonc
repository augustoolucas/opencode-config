{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@cortexkit/opencode-magic-context",
    [
      "yacao@git+https://github.com/augustoolucas/yacao.git",
      { "autoUpdate": true }
    ]
  ],
  "provider": {
    "commandcode": {
      "name": "Command Code",
      "env": [
        "COMMANDCODE_API_KEY"
      ]
    }
  },
  "default_agent": "orchestrator",
  "share": "manual",
  "autoupdate": true,
  "lsp": true,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "crw": {
      "type": "local",
      "command": ["crw-mcp"],
      "enabled": true,
      "environment": { "CRW_API_URL": "http://127.0.0.1:3002" }
    }
  }
}
