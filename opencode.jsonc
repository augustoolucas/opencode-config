{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "fast-opencode-compaction@git+https://github.com/augustoolucas/fast-opencode-compaction.git",
      "options": {
        "enabled": false,
        "provider": "zen",
        "apiKeyCommand": [
          "python3",
          "-c",
          "import json,pathlib,sys;print(json.loads(pathlib.Path(sys.argv[1]).read_text())['opencode-go']['key'])",
          "/home/lucas/.local/share/opencode/auth.json"
        ]
      }
    }
    // "@jevvy/permissions" — disabled 2026-09-24: plugin has no enabled option; uncomment to re-enable
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context",
    "yacao@git+https://github.com/augustoolucas/yacao.git"
  ],
  "provider": {
    "commandcode": {
      "name": "Command Code",
      "env": [
        "COMMANDCODE_API_KEY"
      ]
    }
  },
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "experimental": {
    "subagent_depth": 2
  },
  "permission": {
    "codegraph_*": "allow",
    "crw_*": "allow"
  },
  "share": "manual",
  "autoupdate": true,
  "lsp": true,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "crw": {
      "type": "local",
      "command": ["crw-mcp"],
      "enabled": true,
      "environment": { "CRW_API_URL": "http://127.0.0.1:3002" }
    }
  }
}
